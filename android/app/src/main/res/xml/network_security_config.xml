<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ (API 28+) blocks plain HTTP by default. The TP-RMS server has
  no TLS cert (see server/.env's 192.168.1.x MariaDB/BUSY-ERP hosts and
  the plain-HTTP nginx reverse proxy), so this scopes the cleartext
  exception to its known addresses instead of allowing cleartext traffic
  app-wide. If the server ever moves behind a real domain + HTTPS, delete
  this file and the android:networkSecurityConfig reference in
  AndroidManifest.xml along with it.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Public IP — a router port-forward to the dev Mac's nginx —
             what the app actually uses (see ApiClient.baseUrl), so it
             works over mobile data, not just the same LAN. -->
        <domain includeSubdomains="false">43.255.141.110</domain>
        <!-- LAN-direct address — kept for local testing on the same
             WiFi network without going through the public port-forward. -->
        <domain includeSubdomains="false">192.168.1.133</domain>
        <!-- 10.0.2.2 is the Android emulator's alias for the host
             machine's localhost — needed only for local dev/testing
             against a server run outside the emulator, harmless in a
             real device install since nothing on a phone ever resolves
             to it. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
