{
  "name": "tp-rms-server",
  "version": "1.0.0",
  "description": "TP-RMS backend API — Express + MariaDB, production-structured (centralized error handling, structured logging, health/readiness monitoring).",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/worker.js",
    "worker:dev": "nodemon src/worker.js",
    "migrate": "node src/db/migrate.js",
    "sync:busy": "node src/busySync/runSyncNow.js",
    "seed": "node src/db/seed.js",
    "seed:busy-salesmen": "node src/db/seedBusySalesmen.js",
    "pretest": "MARIADB_DATABASE=BusyRMS_test NODE_ENV=test node src/db/migrate.js",
    "test": "MARIADB_DATABASE=BusyRMS_test NODE_ENV=test node test/run.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^12.7.0",
    "multer": "^2.3.0",
    "mysql2": "^3.11.0",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18"
  }
}
