REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# Used only by the test suite — must differ from REDIS_DB so tests never
# touch dev/smoke data. The test setup flushes this DB before/after each run.
REDIS_TEST_DB=1

# No-Answer attempt threshold before an auto Physical Visit task is created.
# Spec explicitly calls this out as configurable, not fixed at 3.
NO_ANSWER_THRESHOLD=3
NO_ANSWER_VISIT_DEADLINE_HOURS=24

# BUSY sync repeatable job interval, ms. Production would be minutes; kept
# short here so the behavior is observable in dev/smoke runs.
BUSY_SYNC_INTERVAL_MS=300000

# 5 PM Control repeatable job — cron expression, default 17:00 daily.
FIVE_PM_CONTROL_CRON=0 17 * * *

LOG_LEVEL=info
